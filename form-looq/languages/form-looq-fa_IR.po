msgstr "XML — ساخت‌یافته، نام و برچسب فیلدها را نگه می‌دارد"

msgid "Close"
msgstr "بستن"

msgid "Copy failed. Select the text and copy it manually."
msgstr "کپی نشد. متن را انتخاب و دستی کپی کنید."

msgid "Copy the shortcode from the Embed tab into any post, page, or builder."
msgstr "شورت‌کد را از تب کد جاسازی در هر نوشته، برگه یا صفحه‌ساز بگذارید."

msgid "Create your first form and place it on a page."
msgstr "اولین فرم خود را بسازید و روی یک برگه بگذارید."

msgid "Create your first form."
msgstr "اولین فرم خود را بسازید."

msgid "Creating a form"
msgstr "ساخت یک فرم"

msgid "Date format"
msgstr "قالب تاریخ"

msgid "Time format"
msgstr "قالب زمان"

msgid "Site time"
msgstr "زمان سایت"

msgid "UTC time"
msgstr "زمان UTC"

msgid "Delete this entry permanently?"
msgstr "این ورودی برای همیشه حذف شود؟"

msgid "Direction"
msgstr "جهت"

msgid "Follow the site"
msgstr "پیروی از سایت"

msgid "Right to left"
msgstr "راست به چپ"

msgid "Left to right"
msgstr "چپ به راست"

msgid "Embedding a form"
msgstr "جاسازی یک فرم"

msgid "Enter a valid email address."
msgstr "یک نشانی ایمیل معتبر وارد کنید."

msgid "Enter a valid number."
msgstr "یک عدد معتبر وارد کنید."

msgid "Enter a valid telephone number."
msgstr "یک شماره تماس معتبر وارد کنید."

msgid "Review this field and try again."
msgstr "این فیلد را بررسی و دوباره تلاش کنید."

msgid "Select one of the available options."
msgstr "یکی از گزینه‌های موجود را انتخاب کنید."

msgid "This value is longer than the allowed limit."
msgstr "این مقدار از حد مجاز بلندتر است."

msgid "The submission contained unexpected fields. Please reload the page and try again."
msgstr "ارسال شامل فیلدهای غیرمنتظره بود. لطفاً صفحه را دوباره بارگذاری کنید و تلاش کنید."

msgid "Please review the highlighted fields and try again."
msgstr "لطفاً فیلدهای مشخص‌شده را بررسی و دوباره تلاش کنید."

msgid "Entries and privacy"
msgstr "ورودی‌ها و حریم خصوصی"

msgid "Entries live in dedicated database tables on your own site and are never sent anywhere else."
msgstr "ورودی‌ها در جدول‌های اختصاصی دیتابیس روی سایت خودتان ذخیره می‌شوند و هرگز جایی ارسال نمی‌شوند."

msgid "Where entries are stored"
msgstr "ورودی‌ها کجا ذخیره می‌شوند"

msgid "Retention and erasure"
msgstr "نگه‌داری و پاک‌سازی"

msgid "Set a retention window, and use the WordPress privacy tools for personal data requests."
msgstr "یک بازهٔ نگه‌داری تعیین کنید و برای درخواست‌های داده‌های شخصی از ابزارهای حریم خصوصی وردپرس استفاده کنید."

msgid "Getting started"
msgstr "شروع کار"

msgid "How submissions are stored, exported, and erased."
msgstr "ورودی‌ها چگونه ذخیره، برون‌ریزی و پاک می‌شوند."

msgid "Pick a template, name the form, and arrange fields in the builder."
msgstr "یک تمپلیت انتخاب کنید، نام فرم را بگذارید و فیلدها را در فرم‌ساز بچینید."

msgid "More help"
msgstr "راهنمای بیشتر"

msgid "Exports every entry of the selected form. This release intentionally offers no filters or column options — the file is a complete, unfiltered copy."
msgstr "همهٔ ورودی‌های فرم انتخاب‌شده را برون‌ریزی می‌کند. این نسخه عمداً هیچ فیلتر یا گزینهٔ ستونی ندارد — فایل یک نسخهٔ کامل و بدون فیلتر است."

msgid "There are no forms to export yet."
msgstr "هنوز فرمی برای برون‌ریزی وجود ندارد."

msgid "There are no forms yet, so there is nothing to show here."
msgstr "هنوز فرمی وجود ندارد، پس چیزی برای نمایش نیست."

msgid "For per-person data requests, use the built-in WordPress privacy tools at %s."
msgstr "برای درخواست‌های داده‌ای هر شخص، از ابزارهای حریم خصوصی خود وردپرس در %s استفاده کنید."

msgid "Tools → Export Personal Data"
msgstr "ابزارها ← برون‌بری داده‌های شخصی"

msgid "Filter by status"
msgstr "پالایش بر اساس وضعیت"

msgid "Form submissions"
msgstr "ورودی‌های فرم"

msgid "Personal values in submission %d could not be erased."
msgstr "مقادیر شخصی در ورودی %d پاک نشد."

msgid "Multisite"
msgstr "چندسایتی"

msgid "Table prefix"
msgstr "پیشوند جدول"

msgid "PHP memory limit"
msgstr "محدودیت حافظهٔ PHP"

msgid "PHP max execution time"
msgstr "بیشینهٔ زمان اجرای PHP"

msgid "PHP post max size"
msgstr "بیشینهٔ اندازهٔ POST در PHP"

msgid "SSL"
msgstr "SSL"

msgid "cURL"
msgstr "cURL"

msgid "mbstring"
msgstr "mbstring"

msgid "Plain-text report"
msgstr "گزارش متنی"

msgid "No forms yet."
msgstr "هنوز فرمی نیست."

msgid "Open inbox"
msgstr "باز کردن صندوق ورودی"

msgid "Select a form to display."
msgstr "یک فرم برای نمایش انتخاب کنید."

msgid "Select form"
msgstr "انتخاب فرم"

msgid "— Select a form —"
msgstr "— یک فرم انتخاب کنید —"

msgid "Spacing, colours, and typography are controlled by the Advanced tab and your theme."
msgstr "فاصله‌ها، رنگ‌ها و تایپوگرافی با تب پیشرفتهٔ المنتور و پوستهٔ شما کنترل می‌شوند."

msgid "Templates, a drag-and-drop builder, an inbox with admin notes, and one-click embedding anywhere."
msgstr "تمپلیت‌ها، فرم‌ساز درگ‌اند‌دراپ، صندوق ورودی با یادداشت مدیر، و جاسازی یک‌کلیکی در هر جا."

msgid "No frameworks, no build step, and assets load only on pages that actually render a form."
msgstr "بدون فریم‌ورک، بدون مرحلهٔ build، و بارگذاری فایل‌ها فقط در صفحاتی که واقعاً فرم نمایش می‌دهند."

msgid "That entry no longer exists."
msgstr "این ورودی دیگر وجود ندارد."

msgid "That form no longer exists."
msgstr "این فرم دیگر وجود ندارد."

msgid "The form builder needs JavaScript. Enable it to edit fields."
msgstr "فرم‌ساز به جاوااسکریپت نیاز دارد. برای ویرایش فیلدها آن را روشن کنید."

msgid "This entry has no stored values."
msgstr "این ورودی هیچ مقدار ذخیره‌شده‌ای ندارد."

msgid "You do not have permission to manage forms."
msgstr "شما اجازهٔ مدیریت فرم‌ها را ندارید."

msgid "You have unsaved changes."
msgstr "تغییرات ذخیره‌نشده دارید."

msgid "If a submission fails validation, sanitized field values may be stored temporarily in this WordPress installation for up to five minutes so the visitor can correct the form. The browser receives an opaque token rather than the submitted values."
msgstr "اگر ارسالی اعتبارسنجی را رد کند، مقادیر پاک‌سازی‌شدهٔ فیلدها ممکن است تا پنج دقیقه به‌صورت موقت در همین وردپرس نگه‌داری شوند تا بازدیدکننده بتواند فرم را اصلاح کند. مرورگر به‌جای مقادیر ارسالی، یک توکن مبهم دریافت می‌کند."

msgid "Website administrators can choose a submission-retention period, use WordPress personal-data export and erasure tools for matching email addresses, delete submissions manually, and choose whether plugin data should be permanently removed during uninstall."
msgstr "مدیران سایت می‌توانند بازهٔ نگه‌داری ورودی‌ها را تعیین کنند، از ابزارهای برون‌بری و پاک‌سازی داده‌های شخصی وردپرس برای نشانی‌های ایمیل منطبق استفاده کنند، ورودی‌ها را دستی حذف کنند، و انتخاب کنند که آیا داده‌های پلاگین هنگام حذف برای همیشه پاک شود یا نه."

msgid "Top forms by entries"
msgstr "برترین فرم‌ها بر اساس ورودی"

# Added in 0.3.3
msgid "A quick reference for building forms and handling entries."
msgstr "مرجع سریعی برای ساخت فرم و مدیریت ورودی‌ها."

msgid "Alongside the submitted values, each entry also stores the submission time, a salted hash of the visitor’s IP address (only when the form owner enables it), the referring page address, the browser’s user agent string, and — when the visitor was signed in — their WordPress user account. A staff member reviewing the entry may also add a private note."
msgstr "علاوه بر مقادیر ارسالی، هر ورودی زمان ثبت، هش نمکی آی‌پی بازدیدکننده (فقط در صورت فعال بودن آن توسط صاحب فرم)، آدرس صفحهٔ ارجاع‌دهنده، رشتهٔ مرورگر (User Agent) و — در صورت ورود بازدیدکننده — حساب کاربری وردپرس او را نیز ذخیره می‌کند. یک عضو تیم هنگام بررسی ورودی می‌تواند یادداشتی خصوصی نیز اضافه کند."

msgid "Browser user agent"
msgstr "مرورگر کاربر (User Agent)"

msgid "Entries stay on your own site"
msgstr "ورودی‌ها روی سایت شما باقی می‌مانند"

msgid "Export"
msgstr "خروجی گرفتن"

msgid "IP address"
msgstr "آدرس آی‌پی"

msgid "Paste this into a support request. It includes server and environment details — review it before sharing it with anyone outside your own support channel."
msgstr "این متن را در درخواست پشتیبانی جای‌گذاری کنید. شامل جزئیات سرور و محیط است — پیش از اشتراک‌گذاری با هرکسی خارج از کانال پشتیبانی خودتان، آن را بررسی کنید."

msgid "Referring page"
msgstr "صفحهٔ ارجاع‌دهنده"

msgid "Stored as a salted hash, not recoverable in plain form."
msgstr "به‌صورت هش نمکی ذخیره شده و به فرم ساده قابل بازیابی نیست."

msgid "Submitted while signed in as"
msgstr "هنگام ورود با این حساب ارسال شده"

msgid "The plugin does not send submissions anywhere else, does not require a cloud account, and does not enable analytics or telemetry."
msgstr "این افزونه ورودی‌ها را به جای دیگری ارسال نمی‌کند، نیازی به حساب ابری ندارد و آمارگیری یا ردیابی (تلمتری) را فعال نمی‌کند."

msgid "Visit the plugin website"
msgstr "بازدید از وب‌سایت افزونه"

msgid "Take a complete copy of a form's entries."
msgstr "یک نسخهٔ کامل از ورودی‌های یک فرم تهیه کنید."

# Added in 0.4.0 (Form LOOQ rebrand)
msgid "Form LOOQ"
msgstr "فرم لوک"

msgid "Welcome to Form LOOQ"
msgstr "به فرم لوک خوش آمدید"

msgid "Register the Form LOOQ widget in the Elementor editor"
msgstr "ابزارک فرم لوک را در ادیتور المنتور ثبت کن"

msgid "Form LOOQ submissions"
msgstr "ورودی‌های فرم لوک"

msgid "When visitors submit a form created with Form LOOQ, the submitted values are stored in this website’s WordPress database. The specific personal data collected depends on the fields configured by the website administrator."
msgstr "وقتی بازدیدکنندگان فرمی ساخته‌شده با فرم لوک را ارسال می‌کنند، مقادیر ارسالی در پایگاه‌دادهٔ وردپرس همین سایت ذخیره می‌شود. داده‌های شخصی دقیق جمع‌آوری‌شده به فیلدهای پیکربندی‌شده توسط مدیر سایت بستگی دارد."

msgid "Add-ons"
msgstr "افزودنی‌ها"

msgid "Add-ons are a preview in this release."
msgstr "افزودنی‌ها در این نسخه فقط پیش‌نمایش هستند."

msgid "The catalogue below shows what is being built. Activating an add-on will become available in a following release — nothing here is installable yet."
msgstr "فهرست زیر نشان می‌دهد چه چیزی در حال ساخته شدن است. فعال‌سازی یک افزودنی در نسخه‌ای بعدی ممکن می‌شود — هیچ‌کدام از این‌ها هنوز قابل نصب نیستند."

msgid "Showing the bundled catalogue. Fetching the live list from the project site is off — turn it on in %s if you want it."
msgstr "فهرست همراه افزونه نمایش داده می‌شود. دریافت فهرست زندهٔ از سایت پروژه خاموش است — اگر می‌خواهید آن را در %s روشن کنید."

msgid "Showing the bundled catalogue. The live list at %s could not be reached."
msgstr "فهرست همراه افزونه نمایش داده می‌شود. دسترسی به فهرست زنده در %s ممکن نشد."

msgid "Showing the bundled quick reference. The live documentation at %s could not be reached."
msgstr "مرجع سریع همراه افزونه نمایش داده می‌شود. دسترسی به مستندات زنده در %s ممکن نشد."

msgid "Ready-made form packs that add fields, screens, and settings of their own."
msgstr "بسته‌های آماده فرم که فیلد، صفحه و تنظیمات مخصوص به خود را اضافه می‌کنند."

msgid "Visit the project site"
msgstr "بازدید از سایت پروژه"

msgid "Add-on settings"
msgstr "تنظیمات افزودنی‌ها"

msgid "Off by default."
msgstr "به‌طور پیش‌فرض خاموش است."

msgid "Turning this on makes the Add-ons and Help screens request %s. Each request sends only standard HTTP headers plus a user agent identifying the plugin version and this site's own URL — no form content or entry data. Nothing is sent unless you enable it here."
msgstr "روشن کردن این گزینه باعث می‌شود صفحات افزودنی‌ها و راهنما از %s درخواست بگیرند. هر درخواست فقط شامل هدرهای استاندارد HTTP به‌همراه یک user agent حاوی نسخهٔ افزونه و آدرس همین سایت است — بدون هیچ محتوای فرم یا داده ورودی. تا زمانی که اینجا فعالش نکنید، چیزی ارسال نخواهد شد."

msgid "Add-on catalogue"
msgstr "فهرست افزودنی‌ها"

msgid "Fetch the add-on and help catalogue from %s"
msgstr "دریافت فهرست افزودنی‌ها و راهنما از %s"

msgid "When disabled, the bundled catalogue is shown instead and no external request is made."
msgstr "وقتی غیرفعال باشد، به‌جای آن فهرست همراه افزونه نمایش داده می‌شود و هیچ درخواست خارجی ارسال نمی‌شود."

msgid "Cache lifetime (hours)"
msgstr "مدت زمان کش (ساعت)"

msgid "Settings → Add-ons"
msgstr "تنظیمات ← افزودنی‌ها"

msgid "Polls"
msgstr "نظرسنجی"

msgid "Single-question polls with live result bars."
msgstr "نظرسنجی تک‌سؤالی با نوار نتیجهٔ زنده."

msgid "Email notifications"
msgstr "اعلان‌های ایمیلی"

msgid "Send admin alerts and visitor confirmations after each entry."
msgstr "ارسال هشدار به مدیر و تأییدیه به بازدیدکننده پس از هر ورودی."

msgid "Discount codes"
msgstr "کدهای تخفیف"

msgid "Validate coupon codes inside order forms."
msgstr "اعتبارسنجی کد تخفیف در فرم‌های سفارش."

msgid "Quiz"
msgstr "آزمونک"

msgid "Scored questions with pass marks and per-answer feedback."
msgstr "سؤالات نمره‌دار با نمرهٔ قبولی و بازخورد هر پاسخ."

msgid "Survey"
msgstr "پیمایش"

msgid "Multi-page surveys with aggregated reporting."
msgstr "پیمایش چندصفحه‌ای با گزارش تجمیعی."

msgid "User registration"
msgstr "ثبت‌نام کاربر"

msgid "Create WordPress accounts from a form submission."
msgstr "ساخت حساب کاربری وردپرس از روی ارسال فرم."

